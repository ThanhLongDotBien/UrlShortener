@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <span class="eyebrow">Access denied</span>
        <h1 class="auth-title h2 mt-3 mb-2">You do not have permission to open this page.</h1>
        <p class="auth-subtitle mb-4">Please sign in with an authorized account or return to your dashboard.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go back</a>
    </div>
</div>