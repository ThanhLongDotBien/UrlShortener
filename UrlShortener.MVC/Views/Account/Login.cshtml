@model UrlShortener.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrap">
    <div class="auth-card">
        <span class="eyebrow">Welcome back</span>
        <h1 class="auth-title h2 mt-3 mb-2">Login to your account</h1>
        <p class="auth-subtitle mb-4">Manage short links, QR codes, and account settings from one place.</p>

        <form method="post" class="d-grid gap-3">
            <div>
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
            </div>

            <div>
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
            </div>

            <button type="submit" class="btn btn-primary">Login</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert-soft-danger mt-3">@ViewBag.Error</div>
        }

        <p class="helper-text mt-4 mb-0 text-center">
            Don’t have an account?
            <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Create one</a>
        </p>
    </div>
</div>